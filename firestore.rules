rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function messPath(id) { return /databases/$(database)/documents/messes/$(id); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function invitePath(id) { return /databases/$(database)/documents/invitations/$(id); }
    function member(id) {
      return signedIn() && id is string && exists(messPath(id))
        && request.auth.uid in get(messPath(id)).data.memberIds;
    }
    function manager(id) {
      return member(id) && get(messPath(id)).data.managerId == request.auth.uid;
    }
    function available(uid) {
      let id = get(userPath(uid)).data.get('messId', null);
      return id == null || !exists(messPath(id))
        || !(uid in get(messPath(id)).data.memberIds);
    }
    function afterMember(id, uid) {
      return id is string && uid in getAfter(messPath(id)).data.memberIds;
    }
    function acceptedInvite(id, messId, uid) {
      let invitation = get(invitePath(id)).data;
      return id is string && invitation.status == 'pending'
        && invitation.toUserId == uid && invitation.messId == messId
        && invitation.fromUserId == get(messPath(messId)).data.managerId
        && getAfter(invitePath(id)).data.status == 'accepted';
    }
    function validPin(data, uid) {
      return (data.get('managerPinHash', null) == null
          && data.get('managerPinSalt', null) == null)
        || (data.managerPinHash is string
          && data.managerPinHash.matches('^[a-f0-9]{64}$')
          && data.managerPinSalt == uid);
    }
    function auxiliaryWriter(uid) {
      return owner(uid) || manager(get(userPath(uid)).data.get('messId', null));
    }
    function publicProfile(uid, data) {
      let user = getAfter(userPath(uid)).data;
      return data == {
        'uid': uid, 'name': user.get('name', user.get('username', '')),
        'uniqueId': user.uniqueId, 'messId': user.get('messId', null),
        'role': user.get('role', 'member'), 'roomId': user.get('roomId', null)
      };
    }
    function lookupProfile(uid, data) {
      let user = getAfter(userPath(uid)).data;
      return data == {
        'uid': uid, 'name': user.get('name', user.get('username', '')),
        'messId': user.get('messId', null)
      };
    }

    // Entire private documents are owner-readable. No peer can read PIN hashes
    // or emails, even when that peer belongs to the same mess.
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'uniqueId', 'email', 'messId', 'role', 'roomId',
          'managerPinHash', 'managerPinSalt', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.uniqueId.matches('^[A-Z0-9]{8}$')
        && request.resource.data.messId == null
        && request.resource.data.roomId == null
        && request.resource.data.role == 'member'
        && request.resource.data.createdAt is timestamp
        && validPin(request.resource.data, uid)
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.uniqueId)).data.uid == uid
        && publicProfile(uid, getAfter(/databases/$(database)/documents/memberProfiles/$(uid)).data);

      allow update: if
        (owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'managerPinHash', 'managerPinSalt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && validPin(request.resource.data, uid))
        || (owner(uid) && available(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['messId', 'role', 'roomId', 'membershipInvitationId'])
          && request.resource.data.roomId == null
          && afterMember(request.resource.data.messId, uid)
          && (
            (manager(request.resource.data.messId)
              && request.resource.data.role == 'manager')
            || (request.resource.data.role == 'member'
              && acceptedInvite(request.resource.data.membershipInvitationId,
                request.resource.data.messId, uid))
          ))
        || (manager(resource.data.get('messId', null))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['messId', 'role', 'roomId'])
          && (
            (request.resource.data.messId == null
              && request.resource.data.roomId == null
              && request.resource.data.role == 'member')
            || (request.resource.data.messId == resource.data.messId
              && request.resource.data.role == resource.data.role
              && (request.resource.data.roomId == null
                || uid in getAfter(/databases/$(database)/documents/messes/$(resource.data.messId)/rooms/$(request.resource.data.roomId)).data.memberIds))
          ));
    }

    // Sanitized co-member displays. No collection-wide profile enumeration.
    match /memberProfiles/{uid} {
      allow get: if owner(uid) || (member(resource.data.messId)
        && uid in get(messPath(resource.data.messId)).data.memberIds);
      allow create, update: if auxiliaryWriter(uid)
        && publicProfile(uid, request.resource.data);
    }
    // Lookup by an explicitly supplied 8-character invitation code only.
    // These records deliberately contain no email, PIN, or other private data.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && owner(request.resource.data.uid)
        && code == getAfter(userPath(request.auth.uid)).data.uniqueId
        && lookupProfile(request.auth.uid, request.resource.data);
      allow update: if auxiliaryWriter(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && code == getAfter(userPath(resource.data.uid)).data.uniqueId
        && lookupProfile(resource.data.uid, request.resource.data);
    }

    match /messes/{messId} {
      allow read: if member(messId);
      allow create: if signedIn() && available(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'messId', 'name', 'managerId', 'memberIds', 'roomCount', 'createdAt'
        ])
        && request.resource.data.messId == messId
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.roomCount is int
        && request.resource.data.roomCount >= 1
        && request.resource.data.roomCount <= 50
        && request.resource.data.createdAt is timestamp;
      allow update: if
        (manager(messId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'roomCount', 'memberIds'])
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds)
        || (signedIn() && available(request.auth.uid)
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 100
          && request.resource.data.memberIds.removeAll(resource.data.memberIds) == [request.auth.uid]
          && getAfter(userPath(request.auth.uid)).data.messId == messId
          && acceptedInvite(getAfter(userPath(request.auth.uid)).data.membershipInvitationId,
            messId, request.auth.uid));
      allow delete: if manager(messId);

      match /rooms/{roomId} {
        allow read: if member(messId);
        allow write: if manager(messId);
      }
      match /bazarEntries/{id} {
        allow read, delete: if member(messId);
        allow create: if member(messId) && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.entryId == id;
        allow update: if member(messId)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.entryId == resource.data.entryId;
      }
      match /mealEntries/{id} {
        allow read, delete: if member(messId);
        allow create: if member(messId) && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.entryId == id;
        allow update: if member(messId)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.entryId == resource.data.entryId;
      }
      match /messages/{id} {
        allow read, delete: if member(messId);
        allow create: if member(messId)
          && request.resource.data.messageId == id
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == get(userPath(request.auth.uid)).data.name
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 10000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.readBy is map
          && request.resource.data.readBy.keys().hasOnly([request.auth.uid]);
        // Preserve group deletion while limiting edits to the sender. Members
        // may acknowledge their own reads, but cannot forge another's receipt.
        allow update: if member(messId) && (
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isEdited'])
            && request.resource.data.content is string
            && request.resource.data.isEdited == true
            && request.time < resource.data.createdAt + duration.value(30, 'm'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.readBy[request.auth.uid] == request.time)
        );
      }
      match /notices/{id} {
        allow read: if member(messId);
        allow write: if manager(messId);
      }
      match /monthlySummaries/{id} {
        allow read: if member(messId);
        allow write: if manager(messId);
      }
      match /monthlyDeposits/{id} {
        allow read: if member(messId);
        allow write: if manager(messId);
      }
    }

    match /invitations/{id} {
      allow read: if signedIn()
        && (resource.data.toUserId == request.auth.uid || manager(resource.data.messId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'inviteId', 'messId', 'messName', 'fromUserId', 'fromName',
          'toUserId', 'status', 'createdAt'
        ])
        && request.resource.data.inviteId == id
        && request.resource.data.fromUserId == request.auth.uid
        && manager(request.resource.data.messId)
        && request.resource.data.toUserId != request.auth.uid
        && available(request.resource.data.toUserId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'declined'
          || (request.resource.data.status == 'accepted'
            && afterMember(resource.data.messId, request.auth.uid)
            && getAfter(userPath(request.auth.uid)).data.messId == resource.data.messId
            && getAfter(userPath(request.auth.uid)).data.membershipInvitationId == id));
      allow delete: if signedIn()
        && (resource.data.toUserId == request.auth.uid || manager(resource.data.messId));
    }
  }
}
